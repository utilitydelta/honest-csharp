<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <NoWarn>$(NoWarn);RS1038;RS2008;RS1036;NU5128</NoWarn>

    <PackageId>UtilityDelta.Honest.Analyzers</PackageId>
    <RootNamespace>UtilityDelta.Honest.Analyzers</RootNamespace>
    <AssemblyName>UtilityDelta.Honest.Analyzers</AssemblyName>
    <Description>Roslyn analyzers that ban properties, throw, implicit operators and dynamic, so cost and control flow stay visible at the call site. HON001 ships a property-to-field code fix.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visibility="false" />
  </ItemGroup>

  <!-- Ship the analyzer assembly into the analyzer slot of the package. -->
  <ItemGroup>
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visibility="false" />
  </ItemGroup>

</Project>
